<!DOCTYPE html>
<html lang="ro">
<head>
    <%- include('../fragmente/head') %>
</head>
<body>
    <%- include('../fragmente/header') %>

    <main class="container-produs-unic">
        <section style="display: flex; gap: 50px; padding: 20px;">
            <div class="coloana-foto" style="flex: 1;">
                <img src="/imagini/produse/<%= produs.imagine %>" alt="<%= produs.nume %>" style="width: 100%;">
            </div>

            <div class="coloana-info" style="flex: 1;">
                <h1><%= produs.nume %></h1>
                <p class="pret-mare">Preț: <strong><%= produs.pret %> RON</strong></p>
                <hr>
                <p><strong>Descriere completă:</strong> <%= produs.descriere %></p>
                <ul>
                    <li><strong>Categorie:</strong> <%= produs.categorie %></li>
                    <li><strong>Echipă F1:</strong> <%= produs.echipa %></li>
                    <li><strong>Greutate:</strong> <%= produs.greutate_g %> g</li>
                    <li><strong>Data adăugării:</strong> <%= produs.data_adaugare.toLocaleDateString('ro-RO') %></li>
                    <li><strong>Culori disponibile:</strong> <%= produs.culori %></li>
                    <li><strong>Nou în stoc:</strong> <%= produs.este_nou ? "Da" : "Nu" %></li>
                </ul>
                <button class="btn-cumparare">Adaugă în coș</button>
            </div>
        </section>

        <% if (locals.produseSimilare && produseSimilare.length > 0) { %> <%# bonus16 %>
            <section class="produse-similare mt-5">
                <h3 class="mb-4 text-center">Produse Similare</h3>
                <div class="row text-center justify-content-center">
                    <% for(let sim of produseSimilare) { %>
                        <div class="col-md-3">
                            <a href="/echipament/<%= sim.id %>" class="text-decoration-none text-dark">
                                <div class="card h-100 shadow-sm">
                                    <img src="/imagini/produse/<%= sim.imagine %>" class="card-img-top p-2" alt="<%= sim.nume %>" style="height: 150px; object-fit: contain;">
                                    <div class="card-body">
                                        <h5 class="card-title fs-6"><%= sim.nume %></h5>
                                        <p class="card-text text-danger fw-bold"><%= sim.pret %> RON</p>
                                        <p class="card-text small text-muted"><%= sim.echipa %></p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    <% } %>
                </div>
            </section>
        <% } %>

        <a href="/echipamente" style="display: inline-block; margin-top: 20px;">← Înapoi la toate echipamentele</a>
    </main>

    <%- include('../fragmente/footer') %>
</body>
</html>